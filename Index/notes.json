from pathlib import Path
from datetime import datetime

from config import VAULT_PATH


def save_message(text: str):

    now = datetime.now()

    # Создаем структуру Inbox/Год/Месяц/День

    folder = (
        Path(VAULT_PATH)
        / "Inbox"
        / now.strftime("%Y")
        / now.strftime("%m")
        / now.strftime("%d")
    )

    folder.mkdir(parents=True, exist_ok=True)

    filename = now.strftime("%H-%M-%S") + ".md"

    filepath = folder / filename

    # Разделяем сообщение

    lines = text.strip().splitlines()

    if lines:

        title = lines[0].strip()

        body = "\n".join(lines[1:]).strip()

    else:

        title = "Без названия"

        body = ""

    # Если тело отсутствует,
    # не дублируем заголовок

    if body:

        markdown = f"""---
status: NEW
created: {now.strftime("%Y-%m-%d %H:%M:%S")}
source: Telegram

---

# {title}

{body}
"""

    else:

        markdown = f"""---
status: NEW
created: {now.strftime("%Y-%m-%d %H:%M:%S")}
source: Telegram

---

# {title}
"""

    with open(filepath, "w", encoding="utf-8") as f:

        f.write(markdown)

    return filepath